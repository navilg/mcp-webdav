# WebDAV server connection
WEBDAV_URL=https://your-webdav-server.com/remote.php/dav/files/username
WEBDAV_USERNAME=your_webdav_username
WEBDAV_PASSWORD=your_webdav_password

# Test input overrides (optional - defaults used in tests)
TEST_LIST_PATH=/
TEST_DIR_NAME=test-mcp-dir
TEST_FILE_NAME=test-mcp-file.txt
TEST_FILE_CONTENT=Hello, WebDAV MCP Server!
TEST_UPDATE_CONTENT=Updated content for WebDAV MCP Server!
